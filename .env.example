# Copy this file to .env and fill secrets locally. Never commit real values.

# --- Razorpay TEST MODE keys (Dashboard > Settings > API Keys > Test Mode) ---
# When set, the agent creates REAL Razorpay Payment Links in test mode instead
# of mock links.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set this independently in Razorpay Dashboard > Webhooks. It is not the API
# key secret. Razorpay signs the exact raw request body with this value.
RAZORPAY_WEBHOOK_SECRET=

# --- Anthropic API key (https://console.anthropic.com) ---
# When set, the agent uses Claude to generate the root-cause explanation and
# the recovery-action reasoning shown in the audit log. When unset, it falls
# back to a deterministic rule-based reasoning template (still fully logged).
ANTHROPIC_API_KEY=

# --- Simulation controls ---
MAX_AUTO_RETRIES=3
MAX_CONTACT_ATTEMPTS=2
QUIET_HOURS_START=22
QUIET_HOURS_END=8
RECOVERY_TIMEZONE=Asia/Kolkata
