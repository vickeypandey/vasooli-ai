# Razorpay test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Use the separate secret configured for the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=

# Optional. The typed fallback is used when this is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Recovery limits
MAX_AUTO_RETRIES=3
MAX_CONTACT_ATTEMPTS=2
QUIET_HOURS_START=22
QUIET_HOURS_END=8
RECOVERY_TIMEZONE=Asia/Kolkata
